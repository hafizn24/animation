        { "id": "e12_06b", "type": "narrator", "speaker": "NARRATOR", "text": "Farid lari ke kotak. Penjaga gol keluar.", "translation": "Farid runs into the box. The keeper comes out.", "start": 21.5, "end": 24.0, "startFrame": 645, "endFrame": 720, "voice": "voice_6", "trimLeadingSilence": true },
