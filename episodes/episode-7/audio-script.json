          "type": "narrator",
          "speaker": "NARRATOR",
          "text": "Otai Kampung FC. Lambat jalan, tapi mulut lebih laju dari kaki.",
          "translation": "Otai Kampung FC. Slow on the feet, faster with the mouth.",
          "start": 0,
          "end": 4.3,
          "startFrame": 0,
          "endFrame": 129,
          "voice": "voice_1",
          "trimLeadingSilence": true
