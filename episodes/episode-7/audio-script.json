        {
          "id": "e7_02",
          "type": "dialogue",
          "speaker": "PAK DIN",
          "text": "Gaji lima ringgit? Boleh bayar seminggu, bro.",
          "translation": "Five ringgit? I could pay a week's wage, bro.",
          "start": 4.333333333333333,
          "end": 6.966666666666667,
          "startFrame": 130,
          "endFrame": 209,
          "voice": "voice_2",
          "trimLeadingSilence": true
        },
        {
          "id": "e7_03",
          "type": "dialogue",
          "speaker": "AZAM",
          "text": "Boleh la. Tarikh gaji nanti saya panjang tangan sikit.",
          "translation": "Sure. On payday I might get a little grabby.",
          "start": 7,
          "end": 9.933333333333334,
          "startFrame": 210,
          "endFrame": 298,
          "voice": "voice_5",
          "trimLeadingSilence": true
        },
        {
          "id": "e7_04",
          "type": "narrator",
          "speaker": "NARRATOR",
          "text": "Dia jalan perlahan. Tapi matanya baca padang macam main catur.",
          "translation": "He walks slowly. But he reads the pitch like a chessboard.",
