          "id": "e8_01",
          "type": "narrator",
          "speaker": "NARRATOR",
          "text": "Vanguard Elite. Kasut emas, kereta mewah, dan satu sampul tebal.",
          "translation": "Vanguard Elite. Gold boots, fancy cars, and one thick envelope.",
          "start": 0,
          "end": 4.1,
          "startFrame": 0,
          "endFrame": 123,
          "voice": "voice_1",
          "trimLeadingSilence": true
        },
        {
          "id": "e8_02",
          "type": "dialogue",
          "speaker": "RAYYAN",
          "text": "Kelab kau hutang, kan? Ambil la ini. Kalah je hari ni.",
          "translation": "Your club's in debt, right? Take this. Just lose today.",
          "start": 4.133333333333334,
          "end": 7.733333333333333,
          "startFrame": 124,
          "endFrame": 232,
          "voice": "voice_4",
          "trimLeadingSilence": true
        },
        {
          "id": "e8_03",
          "type": "dialogue",
          "speaker": "BOS",
          "text": "Kau fikir kami jual maruah sekali dengan hutang?",
          "translation": "You think we sold our pride along with the debt?",
          "start": 7.766666666666667,
          "end": 10.6,
          "startFrame": 233,
          "endFrame": 318,
          "voice": "voice_3",
          "trimLeadingSilence": true
        },
        {
          "id": "e8_04",
          "type": "narrator",
          "speaker": "NARRATOR",
          "text": "Bos letak sampul tu balik ke tangan Rayyan. Tenang je.",
          "translation": "Boss puts the envelope back in Rayyan's hand. Calm as you like.",
          "start": 10.633333333333333,
          "end": 14.1,
