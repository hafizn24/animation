          "end": 23.9,
          "startFrame": 654,
          "endFrame": 717,
          "voice": "voice_1",
          "trimLeadingSilence": true
        },
        {
          "id": "e8_08",
          "type": "narrator",
          "speaker": "NARRATOR",
          "text": "Dua satu. Gol!",
